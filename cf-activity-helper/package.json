{
  "name": "cf-activity-helper",
  "version": "1.0.0",
  "description": "穿越火线活动领取助手 - 自动完成活动签到、任务和奖励领取",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx scripts/db-init.ts",
    "seed": "tsx scripts/seed-activities.ts",
    "test-login": "tsx scripts/test-login.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.45.0",
    "express": "^4.21.0",
    "better-sqlite3": "^11.0.0",
    "node-cron": "^3.0.3",
    "winston": "^3.14.0",
    "dotenv": "^16.4.0",
    "uuid": "^10.0.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/express": "^5.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "tsx": "^4.16.0",
    "eslint": "^9.0.0"
  }
}
